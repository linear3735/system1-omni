# Settings for tools/h800/dispatch.sh.
#
# Copy to tools/h800/h800.env (git-ignored) and adjust. Environment variables
# already set in your shell win over this file.

# SSH destination that can reach the cluster login node.
H800_HOST=h800-login

# Where runs land on the shared filesystem. One directory per run; the job
# refuses to write anywhere outside /aifs4su.
H800_ROOT=/aifs4su/shiheming/system1-omni/ci-runs

# Scheduler request. These are the values the current H800 jobs use.
H800_PARTITION=training
H800_ACCOUNT=llm
H800_QOS=for_llm
H800_TIME=00:30:00
H800_GPUS=1
H800_CPUS=8
H800_MEM=64G

# Toolkit and interpreter inside the allocation.
H800_CUDA_MODULE=cuda/13.0
H800_PYTHON=python3

# Shared Rust toolchain on the DDN. Its rustup has no default toolchain set,
# so run_h800.sh exports RUSTUP_TOOLCHAIN=1.98.1 for it.
H800_SHARED_TOOLS=/aifs4su/shiheming/system1-omni/cua-s1-20261001-001/tools

# Stages to run: env,build,tier3,tests
H800_STAGES=env,build

# GPU tests are opt-in. Name the cargo target explicitly, for example:
#   H800_TEST_ARGS="-p omni-jev --test cuda -- --ignored"
# The stubs below are the environment variables those tests read:
#   CUA_S1_CUDA_LIB, CUA_S1_MODEL, OPEN_JEV_CUDA_LIB, OPEN_JEV_MODEL, ...
# Use {cuda_build} to point at the libraries this run just built.
H800_TEST_ARGS=
H800_TEST_ENV=

# How long to wait for the allocation before giving up (seconds). Giving up
# leaves the job running and exits 3 (unknown); it does not cancel it.
H800_WAIT_SECONDS=5400

# Job name: bound to this project's run so two projects' ledgers stay apart.
H800_JOB_NAME=omni-h800

# Evidence cap (MB). out/ over this is not pulled back; cuda-build is real
# evidence and counts, caches and weights never do.
H800_EVIDENCE_MAX_MB=512

# Cancel the job when the wait above expires. Default 0: a timeout reports
# "unknown" and keeps the JobID instead of cancelling someone's allocation.
H800_CANCEL_ON_TIMEOUT=0

# Where fetched evidence lands locally. Defaults to artifacts/h800 in the repo.
# H800_ARTIFACT_DIR=
